<Window x:Class="MIDItoMP3.ToolsWindow"
        Icon="main.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MIDItoMP3"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding [ToolsTitle], Source={x:Static local:Loc.Instance}}" Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="{Binding [ToolsIntro], Source={x:Static local:Loc.Instance}}"/>

        <ItemsControl x:Name="ToolList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding Tool.DisplayName}" FontWeight="Bold" Foreground="#FF673AB7"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static local:Loc.Instance}}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Click="Browse_Click"/>
                            <TextBox Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{Binding [Automatic], Source={x:Static local:Loc.Instance}}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding [Cancel], Source={x:Static local:Loc.Instance}}" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button Content="{Binding [Save], Source={x:Static local:Loc.Instance}}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
